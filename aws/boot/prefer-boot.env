# PreFer EC2 baked defaults.
#
# This file is immutable deployment infrastructure. First-boot user-data writes
# deployment overrides to /opt/prefer/deployment.env; systemd loads that file
# second so its values win. Both files are sourceable for debugging:
#   set -a; . /opt/prefer/prefer-boot.env; set +a

# Container image + pinned tag. A fresh `docker pull` runs on every instance
# start, so a new container build is picked up without rebuilding the AMI.
# `provision.sh` rewrites this line at AMI build time from the Packer var.
PREFER_IMAGE=ghcr.io/cvalusek/prefer:latest

# Instance-store NVMe mount point and the models subdir under it. Defaults to
# the DLAMI's own mount (/opt/dlami/nvme), managed by the dlami-nvme service.
NVME_MOUNT=/opt/dlami/nvme
MODELS_SUBDIR=models

# Host port mapped to the container's 8080.
LLM_PORT=8080

# S3 model cache bucket. Enables the sync-down/up path in the container's
# download-models.sh. Blank = disabled (Hugging Face only). Set per deployment.
S3_BUCKET_NAME=

# Explicit deployment preset. Generated AWS presets live under
# /presets/aws/<family>/<size>/ and have sibling .prestage manifests.
# Leave blank only when numeric single-GPU VRAM auto-detection is intended.
LLAMA_ARG_MODELS_PRESET=

# Safe router default for both auto-detected and explicitly selected presets.
# Generated AWS presets contain multiple routes but load only one at a time.
LLAMA_ARG_MODELS_MAX=1

# Optional comma-separated override. Blank lets the selected preset's sibling
# .prestage manifest choose exactly the artifacts required by that scenario.
PRESTAGE_MODELS=
