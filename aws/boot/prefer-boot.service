[Unit]
Description=PreFer llama.cpp inference (stage NVMe + run container)
# cloud-final writes the deployment environment on first boot. Ordering after it
# prevents the baked defaults from launching a competing container first.
# The unit also needs Docker, outbound network, and the DLAMI NVMe mount.
After=cloud-final.service docker.service network-online.target dlami-nvme.service
Wants=network-online.target dlami-nvme.service
Requires=cloud-final.service docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/opt/prefer/prefer-boot.env
EnvironmentFile=-/opt/prefer/deployment.env
ExecStart=/opt/prefer/10-prep-nvme.sh
ExecStart=/opt/prefer/20-run-container.sh
ExecStop=/usr/bin/docker stop prefer
# First boot downloads tens of GB; never time the startup out.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
