{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cvalusek/PreFer/blob/develop/catalog/model-source.schema.json",
  "title": "PreFer authored model source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "display_name", "default", "repositories"],
  "properties": {
    "schema_version": {"const": "prefer.model-source.v1"},
    "display_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "profile": {"$ref": "#/$defs/profile"},
    "default": {"$ref": "#/$defs/selection"},
    "engine_defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "quant": {"type": "string", "minLength": 1}
        }
      }
    },
    "quant_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
      }
    },
    "settings": {"type": "object"},
    "engines": {"$ref": "#/$defs/engines"},
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[^/]+/[^/]+$"},
      "additionalProperties": {"$ref": "#/$defs/repository"}
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "quant"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "quant": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "total_parameters_b": {"type": ["number", "null"], "minimum": 0},
            "active_parameters_b": {"type": ["number", "null"], "minimum": 0},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "native_input": {"$ref": "#/$defs/stringList"},
            "configured_input": {"$ref": "#/$defs/stringList"},
            "output": {"$ref": "#/$defs/stringList"}
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "native_tokens": {"type": ["integer", "null"], "minimum": 1},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "control": {"type": "string", "minLength": 1},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferred": {"$ref": "#/$defs/stringList"},
            "capable": {"$ref": "#/$defs/stringList"},
            "avoid": {"$ref": "#/$defs/stringList"}
          }
        },
        "strengths": {"$ref": "#/$defs/stringList"},
        "limitations": {"$ref": "#/$defs/stringList"},
        "prompting": {"$ref": "#/$defs/stringList"},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confidence"],
          "properties": {
            "confidence": {"enum": ["high", "mixed", "limited"]},
            "basis": {"$ref": "#/$defs/stringList"},
            "notes": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "settings": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "engines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/engine"}
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "discover": {"const": "gguf"},
        "settings": {"type": "object"},
        "quants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "include": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/artifact"}
              },
              "settings": {"type": "object"},
              "engines": {"$ref": "#/$defs/engines"}
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "include": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "role": {"type": "string", "minLength": 1},
        "settings": {"type": "object"}
      }
    }
  }
}
