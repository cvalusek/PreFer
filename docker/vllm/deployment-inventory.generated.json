  "experimental_routes": {
    "qwen-3.8-flash": {
      "status": "deferred-experimental",
      "reason": "Official recipe requires the dedicated qwen38-flash-next image and multi-GB300-class deployments; it is not part of this first 27B lane."
    },
    "dflash2": {
      "status": "deferred-unverified",
      "reason": "vLLM exposes DFlash2 for Qwen3.8 only in newer releases; do not replace the verified native MTP path without a matched artifact and smoke."
    }
  },
  "known_limitations": [
    "The checked-in deployment scenarios are configuration-only until an exact Blackwell card passes load, API, context, and throughput smoke.",
    "Native MTP is first enabled at TP1; current qwen3_5_mtp TP>=2 loader issues are intentionally not hidden by a multi-GPU default.",
    "The vLLM recipe verifies text serving; image and video input remain native capability metadata until the PreFer multimodal smoke passes.",
    "A 32 GB Blackwell route may require enforce-eager and a smaller context because CUDA graph capture can OOM outside the model memory budget.",
    "Model weights are runtime artifacts and never belong in this image or grouped release artifact."
  ],
  "api": {
    "health": "GET /health",
    "models": "GET /v1/models",
    "chat": "POST /v1/chat/completions",
