      "model_keys": ["qwen3.8-27b-nvfp4"],
      "server": {
        "context_length": 524288,
        "mem_fraction_static": 0.92,
        "max_running_requests": 4,
        "cuda_graph_max_bs": 4,
        "mamba_ssm_dtype": "bfloat16",
        "mamba_full_memory_ratio": 2.29,
        "mamba_radix_cache_strategy": "extra_buffer_lazy",
        "max_mamba_cache_size": 150,
        "speculative": {
          "enabled": true,
          "algorithm": "NEXTN",
          "num_steps": 3,
          "eagle_topk": 1,
          "num_draft_tokens": 4
        }
      }
    },
    {
      "name": "target-only",
      "description": "RTX PRO 6000 FP8-KV target-only control with the same 524K per-request pool and concurrency envelope, isolating the NVFP4 target from embedded MTP.",
      "model_keys": ["qwen3.8-27b-nvfp4"],
      "server": {
        "context_length": 524288,
        "mem_fraction_static": 0.92,
        "max_running_requests": 4,
        "cuda_graph_max_bs": 4,
        "mamba_ssm_dtype": "bfloat16",
        "mamba_full_memory_ratio": 2.29,
        "mamba_radix_cache_strategy": "extra_buffer_lazy",
        "max_mamba_cache_size": 150,
        "speculative": {
          "enabled": false
        }
      }
    },
    {
      "name": "fidelity",
      "description": "RTX PRO 6000 single-user BF16-KV fidelity alternate at 524K; no speculative decoding and no FP8 KV scale dependency.",
      "model_keys": ["qwen3.8-27b-nvfp4"],
      "server": {
        "context_length": 524288,
        "mem_fraction_static": 0.9,
        "max_running_requests": 1,
        "cuda_graph_max_bs": 1,
        "kv_cache_dtype": "bfloat16",
        "mamba_ssm_dtype": "bfloat16",
        "mamba_full_memory_ratio": 2.0,
        "mamba_radix_cache_strategy": "extra_buffer_lazy",
        "max_mamba_cache_size": 24,
        "speculative": {
