{
  "name": "prefer-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/prefer"
  ],
  "scripts": {
    "build": "npm run build --workspace prefer-inference-core",
    "test": "npm run test --workspace prefer-inference-core && node scripts/check-model-catalog-coverage.mjs",
